{
    "manifest_version": 3,
    "name": "YouTube Auto Skip",
    "version": "2.2",
    "description": "Automatically skips ads and dislikes videos from specified channels on YouTube",
    "permissions": [
        "storage",
        "tabs"
    ],
    "host_permissions": [
        "*://*.youtube.com/*"
    ],
    "background": {
        "service_worker": "background.js"
    },
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "16": "images/icon16.png",
            "48": "images/icon48.png",
            "128": "images/icon128.png"
        }
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.youtube.com/*"
            ],
            "js": [
                "channels.js",
                "content.js"
            ]
        }
    ]
}